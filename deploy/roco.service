[Unit]
Description=Roco Python API and private debug console
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=roco
Group=roco
WorkingDirectory=/opt/roco/app
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/roco/roco.env
ExecStart=/opt/roco/conda/envs/hello-agents/bin/python -m roco_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/roco/app/data /opt/roco/app/logs
UMask=0027

[Install]
WantedBy=multi-user.target
